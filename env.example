# Database (PostgreSQL via Docker or managed)
DATABASE_URL="postgresql://portscope:portscope@localhost:5432/portscope?schema=public"

# ─── LLM Provider Configuration ──────────────────────────────────────────────
# LLM_PROVIDER options: ollama, anthropic, openrouter, huggingface, openai, vllm, custom
LLM_PROVIDER="ollama"

# For Ollama (default, local):
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.1:8b"
# LLM_API_KEY is not needed for Ollama

# For Anthropic Claude:
# LLM_PROVIDER="anthropic"
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# For OpenRouter (access to 100+ models):
# LLM_PROVIDER="openrouter"
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="sk-or-..."
# LLM_MODEL="anthropic/claude-3.5-sonnet"

# For HuggingFace Inference API:
# LLM_PROVIDER="huggingface"
# LLM_BASE_URL="https://api-inference.huggingface.co/v1"
# LLM_API_KEY="hf_..."
# LLM_MODEL="meta-llama/Llama-3.1-8B-Instruct"

# For OpenAI:
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o"

# For self-hosted vLLM:
# LLM_PROVIDER="vllm"
# LLM_BASE_URL="http://your-gpu-server:8000/v1"
# LLM_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"

# ─── Services ────────────────────────────────────────────────────────────────
EXTRACTOR_URL="http://localhost:8001"

# Auth
AUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Temporal
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="portscope"

# S3 / Object Storage (MinIO for local dev)
S3_BUCKET="portscope-documents"
S3_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# App
NEXT_PUBLIC_APP_NAME="Portscope"
NEXT_PUBLIC_API_URL="http://localhost:3001"
