# ═══════════════════════════════════════════════════════════════════════════════
# Portscope Cloud Environment Template
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER="openrouter"
LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY="sk-or-v1-YOUR_KEY"
LLM_MODEL="google/gemini-2.5-flash"

# ─── Database (Neon Serverless Postgres — https://neon.tech) ──────────────────
# Create project → copy connection string from dashboard
DATABASE_URL="postgresql://USER:PASSWORD@HOST/portscope?sslmode=require"

# ─── Object Storage (Cloudflare R2 — https://dash.cloudflare.com) ─────────────
# R2 → Create bucket "portscope-documents"
# R2 → Manage R2 API Tokens → Create token (Object Read & Write)
S3_BUCKET="portscope-documents"
S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY="YOUR_R2_ACCESS_KEY"
S3_SECRET_KEY="YOUR_R2_SECRET_KEY"

# ─── Services ─────────────────────────────────────────────────────────────────
# After deploying to Railway, fill in the URLs:
EXTRACTOR_URL="https://portscope-extractor-production.up.railway.app"

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_SECRET="GENERATE_A_RANDOM_64_CHAR_SECRET"
NODE_ENV="development"

# ─── CORS (set to your Vercel URL after deploying frontend) ───────────────────
CORS_ORIGIN="http://localhost:3000,https://portscope.vercel.app"

# ─── Frontend env (set in Vercel dashboard) ───────────────────────────────────
# NEXT_PUBLIC_APP_NAME="Portscope"
# NEXT_PUBLIC_API_URL="https://portscope-api-production.up.railway.app"
